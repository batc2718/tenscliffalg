class CarCoordsys:
    def __init__(self,sym,dim=3,indexes=[1,2,3],includesym=True,vecsym='e'):
        self.sym=sym
        self.dim=dim
        self.vecindexes=[f"{indexes[n]}" for n in range(dim)]
        if includesym==True:# For [x1,x2,x3]
            self.indexes=[f"{sym}{indexes[n]}" for n in range(dim)]
            self.basis=symbols([f"{sym}_{indexes[n]}" for n in range(dim)],commutative=False)
        if includesym==False:# For [x,y,z]
            self.indexes=[f"{indexes[n]}" for n in range(dim)]
            self.basis=symbols([f"{vecsym}_{indexes[n]}" for n in range(dim)],commutative=False)
        
    def __str__(self):
        return self.sym
    def __hash__(self):
        return hash(self.sym)

