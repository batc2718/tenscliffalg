class points:
    def __init__(self,coordsys,components,sym):
        self.names=sym.split(" ")
        self.coordsys=coordsys
        self.comps=components

class displacement:
    def __init__(self,pnt:points):
        self.points=pnt
    def __truediv__(self,other):
        pass

class Force:
    def __init__(self,sym,pnt:points):
        self.sym=sym
        for n in range(len(pnt.comps)):
            temp=vec(f"{sym}_{pnt.names[n]}",pnt.coordsys)
            setattr(self,pnt.names[n],temp)

